.runios-io-node-tree-view__cell {
    flex-direction: row;
    flex-grow: 1;
    text-overflow: ellipsis;
    -unity-text-align: middle-left;
    white-space: nowrap;
    justify-content: flex-start;
}

.runios-io-node-tree-view__cell#size {
    -unity-text-align: middle-right;
}

.runios-io-node-tree-view__icon {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
    align-self: center;
    margin-right: 4px;
}

.runios-io-node-tree-view__name-cell > .runios-io-node-tree-view__loading-image {
    display: none;
}

.runios-io-node-tree-view__name-cell--loading > .runios-io-node-tree-view__loading-image {
    display: flex;
}

.runios-io-node-tree-view__loading-image {
    align-self: center;
}

.runios-io-browser .unity-multi-column-view__header-container {
    flex-shrink: 0;
}

.runios-io-browser .unity-multi-column-view__cell {
    justify-content: flex-start;
}
