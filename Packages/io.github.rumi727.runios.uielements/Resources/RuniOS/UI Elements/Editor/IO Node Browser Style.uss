.runios-io-node-browser__navigation-button {
    width: 25px;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
    height: 20px;
}

.runios-io-node-browser__navigation-button .unity-image {
    width: 16px;
    height: 16px;
}

.runios-io-node-browser__path-field {
    margin-left: 0;
    margin-right: 2px;
    margin-bottom: 2px;
    margin-top: 2px;
}

.runios-io-node-browser > .runios-separator {
    display: none;
}
