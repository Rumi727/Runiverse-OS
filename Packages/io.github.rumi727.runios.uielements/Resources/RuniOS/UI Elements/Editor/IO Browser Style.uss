.runios-io-browser .runios-io-browser__header-button {
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
}

.runios-io-browser .runios-io-browser__navigation-button {
    width: 25px;
}

.runios-io-browser__navigation-button .unity-image {
    width: 16px;
    height: 16px;
}

.runios-io-browser__path-prefix-label {
    padding-left: 0;
    padding-right: 0;
    margin-left: 2px;
    margin-right: 1px;
}

.runios-io-browser__path-field {
    margin-left: 0;
    margin-right: 2px;
    margin-bottom: 2px;
    margin-top: 2px;
}

.runios-io-browser .runios-io-browser__folder-menu {
    margin-left: 0;
    border-right-width: 0;
    width: auto;
}

.runios-io-browser > .runios-separator {
    display: none;
}

.runios-file-system-browser__place-space-bar {
    height: 4px;
    margin-left: 0;
    margin-right: 0;
    margin-top: 1px;
    margin-bottom: 0;
}

.runios-file-system-browser__place-space-bar .unity-progress-bar__background {
    min-height: 4px;
    height: 4px;
}

.runios-io-browser__breadcrumb-bar {
    margin-left: 0;
    margin-right: 2px;
    margin-top: 2px;
    margin-bottom: 2px;
}

.runios-io-breadcrumb-bar__crumb,
.runios-io-breadcrumb-bar__arrow {
    margin-left: 0;
    margin-right: 0;
    margin-top: 0;
    margin-bottom: 0;
    padding-top: 3px;
    padding-bottom: 3px;
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
    background-color: rgba(0, 0, 0, 0);
}

.runios-io-breadcrumb-bar__crumb {
    padding-left: 8px;
    padding-right: 8px;
}

.runios-io-breadcrumb-bar__arrow {
    padding-left: 5px;
    padding-right: 5px;
}

.runios-io-breadcrumb-bar__crumb:hover,
.runios-io-breadcrumb-bar__arrow:hover {
    background-color: rgba(128, 128, 128, 0.2);
}

/* 트리 뷰에 놓을 때와 같은 색으로 칠합니다. */
.runios-io-breadcrumb-bar__crumb.runios-io-breadcrumb-bar__crumb--drop-target,
.runios-menu-item.runios-io-breadcrumb-bar__menu-item--drop-target {
    background-color: rgba(64, 128, 255, 0.25);
}

.runios-io-breadcrumb-bar__blank {
    min-width: 20px;
}

.runios-io-breadcrumb-bar__edit-button {
    width: 22px;
    margin-left: 0;
    margin-right: 0;
    margin-top: 0;
    margin-bottom: 0;
    padding-left: 0;
    padding-right: 0;
    padding-top: 0;
    padding-bottom: 0;
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
    background-color: rgba(0, 0, 0, 0);
}

.runios-io-breadcrumb-bar__edit-button:hover {
    background-color: rgba(128, 128, 128, 0.2);
}

.runios-io-breadcrumb-bar__edit-button .unity-image {
    width: 16px;
    height: 16px;
}
