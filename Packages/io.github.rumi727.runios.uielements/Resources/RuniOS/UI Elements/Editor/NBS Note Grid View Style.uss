.runios-nbs-note-grid-view__stopper-guide {
    --runios-nbs-stopper-guide-color: var(--unity-colors-label-text);
}

.runios-nbs-note-grid-view__layer-header {
    padding-left: 4px;
    padding-right: 4px;
}

.runios-nbs-note-grid-view__layer-header--locked {
    opacity: 0.5;
}

.runios-nbs-note-grid-view__layer-header--solo {
    background-color: rgba(255, 200, 0, 0.15);
}

.runios-nbs-note-grid-view__layer-number {
    min-width: 24px;
    margin-right: 4px;
    -unity-text-align: middle-right;
    color: var(--unity-colors-label-text);
    opacity: 0.6;
}

.runios-nbs-note-grid-view__layer-name {
    text-overflow: ellipsis;
    color: var(--unity-colors-label-text);
}

.runios-nbs-note-grid-view__notes--muted {
    opacity: 0.4;
}

.runios-nbs-note-grid-view__playhead {
    width: 2px;
    background-color: rgb(255, 255, 255);
}

.runios-nbs-note-grid-view__playhead-marker {
    left: -5px;
    width: 12px;
    height: 10px;
}

.runios-nbs-note-grid-view__save-popup {
    top: 80%;
    translate: -50% -100%;
    height: 40px;
    padding: 0 10px;
    border-width: 1px;
    border-radius: 4px;
    border-color: var(--unity-colors-default-border);
    background-color: var(--unity-colors-window-background);
    color: var(--unity-colors-label-text);
    font-size: 15px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.runios-nbs-note-block__tint--down {
    background-color: rgb(255, 0, 0);
}

.runios-nbs-note-block__tint--up {
    background-color: rgb(0, 0, 255);
}

.runios-nbs-note-block__key {
    padding-top: 1px;
    font-size: 10px;
    color: rgb(255, 255, 0);
    text-shadow: 1px 1px 0 rgba(0, 0, 0, 0.6);
}

.runios-nbs-note-block__value {
    padding-top: 6px;
    font-size: 10px;
    color: rgb(255, 255, 255);
    text-shadow: 1px 1px 0 rgba(0, 0, 0, 0.6);
}

.runios-nbs-preview-toolbar__time {
    margin-right: 4px;
    color: var(--unity-colors-label-text);
}

.runios-nbs-preview-toolbar__icon {
    width: 16px;
    height: 16px;
}

.runios-nbs-preview-toolbar__volume {
    width: 75px;
    margin-left: 4px;
    margin-right: 4px;
}

.runios-nbs-note-info {
    padding: 4px 8px;
}

.runios-nbs-note-info__name {
    min-width: 96px;
    margin-right: 8px;
    opacity: 0.6;
}
