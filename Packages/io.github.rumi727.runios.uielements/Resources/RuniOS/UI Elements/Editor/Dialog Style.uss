.runios-dialog__overlay {
    background-color: rgba(0, 0, 0, 0.4);
}

.runios-dialog {
    min-width: 280px;
    max-width: 480px;
    padding-top: 12px;
    padding-right: 12px;
    padding-bottom: 12px;
    padding-left: 12px;
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-right-radius: 4px;
    border-bottom-left-radius: 4px;
    background-color: var(--unity-colors-window-background);
    border-top-color: var(--unity-colors-dropdown-border);
    border-right-color: var(--unity-colors-dropdown-border);
    border-bottom-color: var(--unity-colors-dropdown-border);
    border-left-color: var(--unity-colors-dropdown-border);
}

.runios-dialog__title {
    margin-bottom: 8px;
    font-size: 14px;
    -unity-font-style: bold;
}

.runios-dialog__buttons {
    margin-top: 12px;
    justify-content: flex-end;
}

.runios-dialog__button {
    min-width: 72px;
    margin-left: 6px;
    margin-right: 0;
}
