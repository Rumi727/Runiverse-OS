.runios-grid-view {
    flex-grow: 1;
    overflow: hidden;
}

.runios-grid-view__viewport {
    flex-grow: 1;
    flex-direction: column;
    overflow: hidden;
}

.runios-grid-view__top {
    flex-direction: row;
    flex-shrink: 0;
}

.runios-grid-view__corner {
    flex-shrink: 0;
}

.runios-grid-view__rulers {
    flex-grow: 1;
    flex-direction: column;
    overflow: hidden;
}

.runios-grid-view__scroll-view {
    flex-grow: 1;
}

.runios-grid-view__horizontal-range-slider {
    flex-shrink: 0;
}

.runios-grid-view__overlay {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
}

.runios-grid-view__marquee {
    position: absolute;
    left: 0;
    top: 0;
    display: none;
}

.runios-grid-view__marquee--active {
    display: flex;
}

.runios-grid-view__popup-layer {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    overflow: hidden;
}

.runios-grid-ruler {
    flex-shrink: 0;
    overflow: hidden;
}

.runios-grid-track {
    flex-direction: row;
    flex-shrink: 0;
}

/* 헤더를 흐름에서 빼서, 헤더 내용이 얼마나 높든 트랙이 레이어 높이를 따르게 합니다. 레이어는 GridView.headerWidth로 설정되는 왼쪽 여백으로 헤더 자리를 비웁니다. */
.runios-grid-track__header {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    overflow: hidden;
}

.runios-grid-track__layer {
    flex-grow: 1;
}

.runios-grid-layer {
    overflow: hidden;
}

.runios-grid-item {
    position: absolute;
    left: 0;
    top: 0;
}

.runios-grid-popup {
    position: absolute;
    left: 0;
    top: 0;
}
