.runios-nbs-note-grid-view {
    flex-grow: 1;
}

.runios-nbs-note-grid-view__grid {
    flex-grow: 1;
}

.runios-nbs-note-grid-view__time {
    flex-grow: 1;
    justify-content: center;
    align-items: center;
    overflow: hidden;
    -unity-text-align: middle-center;
    white-space: nowrap;
}

.runios-nbs-note-grid-view__time-details {
    flex-direction: row;
    justify-content: center;
}

.runios-nbs-note-grid-view__layer-header {
    flex-direction: row;
    align-items: center;
    overflow: hidden;
}

.runios-nbs-note-grid-view__layer-name {
    flex-grow: 1;
    flex-shrink: 1;
    white-space: nowrap;
    overflow: hidden;
}

.runios-nbs-note-grid-view__layer-lock {
    flex-shrink: 0;
    align-items: center;
}

.runios-nbs-note-grid-view__layer-solo {
    flex-shrink: 0;
    -unity-text-align: middle-center;
}

.runios-nbs-note-grid-view__playhead {
    bottom: 0;
}

.runios-nbs-note-grid-view__playhead-marker {
    position: absolute;
    top: 0;
}

.runios-nbs-note-grid-view__locked-layer-shade {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
}

.runios-nbs-note-grid-view__stopper-guide {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    overflow: hidden;
}

.runios-nbs-note-grid-view__effect-overlay,
.runios-nbs-note-grid-view__accent {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.runios-nbs-note-grid-view__save-popup {
    position: absolute;
    left: 50%;
    white-space: nowrap;
}

.runios-nbs-note-block {
    overflow: hidden;
}

.runios-nbs-note-block__tint {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.runios-nbs-note-block__key {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    -unity-text-align: upper-center;
    white-space: nowrap;
}

.runios-nbs-note-block__value {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    -unity-text-align: middle-center;
    white-space: nowrap;
}

.runios-nbs-preview-toolbar {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
}

.runios-nbs-preview-toolbar__button {
    flex-direction: row;
    align-items: center;
    justify-content: center;
}

.runios-nbs-note-info__row {
    flex-direction: row;
}

.runios-nbs-note-info__value {
    flex-shrink: 1;
    white-space: normal;
}
