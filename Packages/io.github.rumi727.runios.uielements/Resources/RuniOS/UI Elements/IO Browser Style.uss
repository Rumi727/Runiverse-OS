.runios-io-browser {
    flex-grow: 1;
}

.runios-io-browser__header {
    flex-shrink: 0;
}

.runios-io-browser .runios-io-browser__path-field {
    flex-shrink: 1;
}

.runios-io-browser__path-prefix-label {
    -unity-text-align: middle-right;
}

.runios-io-browser__content-pane > * {
    flex-grow: 1;
}

.runios-device-location-view {
    flex-direction: row;
    flex-wrap: wrap;
    align-content: flex-start;
}

.runios-device-location-view__item {
    width: 250px;
    flex-direction: column;
    align-items: stretch;
}

.runios-device-location-view__item-label {
    -unity-text-align: middle-left;
}

.runios-io-browser-place-group__header {
    -unity-font-style: bold;
    padding-left: 4px;
    margin-top: 4px;
}

.runios-io-browser-place {
    padding-left: 6px;
    padding-right: 6px;
    padding-top: 2px;
    padding-bottom: 2px;
}

.runios-io-browser-place:hover {
    background-color: rgba(128, 128, 128, 0.2);
}

.runios-io-browser-place__label {
    -unity-text-align: middle-left;
    padding-left: 0;
    padding-right: 0;
    white-space: nowrap;
    text-overflow: ellipsis;
}

.runios-file-system-browser__place-space-bar {
    height: 4px;
    margin-left: 0;
    margin-right: 0;
    margin-top: 1px;
    margin-bottom: 0;
}

.runios-file-system-browser__place-space-bar .unity-progress-bar__background {
    min-height: 4px;
    height: 4px;
}
