%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 4877a65100aa43f7b113ba2717f32cbc, type: 3}
  m_Name: ja_jp
  m_EditorClassIdentifier: 
  texts:
    pairs:
    - key: language.name
      value: "\u65E5\u672C\u8A9E"
    - key: language.region
      value: "\u65E5\u672C"
    - key: installer.welcome
      value: "\u3088\u3046\u3053\u305D\uFF01"
    - key: installer.welcome.text
      value: "Runi Engine\u3092\u3054\u5229\u7528\u3044\u305F\u3060\u304D\u3042\u308A\u304C\u3068\u3046\u3054\u3056\u3044\u307E\u3059\u3002\n\u3053\u308C\u304B\u3089\u30A8\u30F3\u30B8\u30F3\u306E\u521D\u671F\u8A2D\u5B9A\u3092\u958B\u59CB\u3057\u307E\u3059\u3002"
    - key: installer.tmp_setting.label
      value: "TMP\u30EA\u30BD\u30FC\u30B9"
    - key: installer.tmp_setting.warning
      value: "TextMeshPro\u30D1\u30C3\u30B1\u30FC\u30B8\u304C\u30A4\u30F3\u30B9\u30C8\u30FC\u30EB\u3055\u308C\u3066\u3044\u307E\u305B\u3093\u3002"
    - key: installer.tmp_setting.info
      value: "ROS\u30D1\u30C3\u30B1\u30FC\u30B8\u306F Unity\u306ETextMesh Pro\u30D1\u30C3\u30B1\u30FC\u30B8\u3092\u4F7F\u7528\u3057\u3066\u3044\u307E\u3059\u3002\n\u5186\u6ED1\u306A\u5229\u7528\u306E\u305F\u3081\u306B\u3001TextMesh Pro\u306E\u57FA\u672C\u30EA\u30BD\u30FC\u30B9\u3092\u30A4\u30F3\u30DD\u30FC\u30C8\u3059\u308B\u3053\u3068\u3092\u304A\u52E7\u3081\u3057\u307E\u3059\u3002\r"
    - key: installer.install_setting.install
      value: "\u30A4\u30F3\u30B9\u30C8\u30FC\u30EB"
    - key: installer.install_setting.dependency
      value: "\u4F9D\u5B58\u95A2\u4FC2"
    - key: installer.install_setting.core.label
      value: "Runiverse OS Core"
    - key: installer.install_setting.core.one_line
      value: "共通ユーティリティとリソース管理"
    - key: installer.install_setting.core.description
      value: "RuniOS パッケージが共有するユーティリティ、非同期タスク、IO 抽象化、リソースパックとローカライズを提供します。"
    - key: installer.install_setting.ui.label
      value: "Runiverse OS UI"
    - key: installer.install_setting.ui.one_line
      value: "RuniOS の公式ランタイム UI/UX システム"
    - key: installer.install_setting.ui.description
      value: "osu!lazer に着想を得たデザインで RuniOS の機能を操作するランタイム UI/UX システムです。すべての RuniOS 機能パッケージと SoftMask for uGUI を使用する設計です。UI/UX の実装は予定されており、現在のコンポーネントはリソースを Unity UI に接続します。"
    - key: installer.setup.roots.title
      value: "ルートパッケージの選択"
    - key: installer.tmp_setting.essentials.title
      value: "TMP 必須リソース"
    - key: installer.tmp_setting.essentials.info
      value: "TextMesh Pro の必須リソースを Assets/TextMesh Pro にインポートします。"
    - key: installer.tmp_setting.essentials.update
      value: "TMP リソースの更新が必要です。TMP Settings を保持して再インポートします。"
    - key: installer.tmp_setting.essentials.import
      value: "TMP 必須リソースをインポート"
    - key: installer.tmp_setting.examples.title
      value: "TMP サンプルと追加リソース"
    - key: installer.tmp_setting.examples.info
      value: "TextMesh Pro の使い方を確認できる任意のサンプルと追加リソースです。必須リソースを先にインポートしてください。"
    - key: installer.tmp_setting.examples.update
      value: "更新された TMP サンプルと追加リソースを再インポートします。"
    - key: installer.tmp_setting.examples.import
      value: "TMP サンプルと追加リソースをインポート"
    - key: installer.setup.preview.title
      value: "変更内容のプレビュー"
    - key: installer.setup.preview.info
      value: "選択したルートと依存関係を Package Management が確認します。プレビューは参考情報で、インストール時に現在の状態を再確認します。選択解除してもインストール済みパッケージは削除しません。TMP リソースは TMP 画面で別途インポートします。"
    - key: installer.setup.preview.empty
      value: "ルートパッケージが選択されていません。"
    - key: installer.setup.preview.observing
      value: "インストール要件を確認中…"
    - key: installer.setup.preview.ensuring
      value: "インストール要件を適用中…"
    - key: installer.setup.preview.ready
      value: "プレビュー完了。インストール時に現在の状態を再確認します。"
    - key: installer.setup.preview.graph_error
      value: "インストール前に依存関係グラフのエラーを解決してください。"
    - key: installer.setup.preview.complete
      value: "すべてのインストール要件を満たしました。"
    - key: installer.setup.preview.assembly_required
      value: "パッケージ説明に記載された外部統合を先にインポートしてから更新してください。"
    - key: installer.setup.preview.failed
      value: "失敗しました。診断内容を確認してください。"
    - key: installer.setup.preview.cancelled
      value: "キャンセルしました。開始済みの UPM リクエストは完了まで待機しました。"
    - key: installer.setup.preview.refresh
      value: "プレビューを更新"
    - key: installer.setup.preview.cancel
      value: "キャンセル"
    - key: installer.setup.preview.root
      value: "選択したルート"
    - key: installer.setup.preview.dependency
      value: "依存パッケージ"
    - key: installer.setup.preview.satisfied
      value: "充足済み"
    - key: installer.setup.preview.required
      value: "インストールが必要"
    - key: installer.setup.preview.registry_required
      value: "レジストリの準備が必要。パッケージ取得は UPM に委任"
    - key: installer.setup.preview.delegated
      value: "レジストリ準備済み。パッケージ取得は委任され、検証されません"
    - key: installer.setup.preview.unsupported
      value: "この executor はプレビューに対応していません"
    - key: installer.install_setting.sound.label
      value: "Runiverse OS Sound"
    - key: installer.install_setting.sound.one_line
      value: "共通オーディオ API とサウンドリソース"
    - key: installer.install_setting.sound.description
      value: "オーディオ実装で共有するクリップ、再生・空間オーディオの契約、Unity のオーディオソースコンポーネントとサウンドリソース登録を提供します。"
    - key: installer.install_setting.effects.label
      value: "Runiverse OS Effects"
    - key: installer.install_setting.effects.one_line
      value: "角丸とアウトラインエフェクト"
    - key: installer.install_setting.effects.description
      value: "Unity UI の角丸とメッシュのアウトラインエフェクトを提供します。複数オブジェクトのアウトラインを結合するエフェクトも含みます。"
    - key: installer.install_setting.fmod.label
      value: "FMOD for RuniOS"
    - key: installer.install_setting.fmod.one_line
      value: "RuniOS 向け FMOD オーディオ再生"
    - key: installer.install_setting.fmod.description
      value: "RuniOS サウンドリソースと連携する FMOD Core サウンドシステム、オーディオクリップ、再生チャンネルとチャンネルグループを提供します。FMOD for Unity の統合は別途用意する必要があり、Setup ではインストールしません。"
    - key: installer.install_setting.nbs.label
      value: "Runiverse OS NBS"
    - key: installer.install_setting.nbs.one_line
      value: "Note Block Studio ファイルのロードと再生"
    - key: installer.install_setting.nbs.description
      value: "RuniOS リソースパックから Note Block Studio ファイルを読み込み、FMOD で音符を再生します。テンポマップ、カスタム楽器とエディタープレビューに対応します。"
    - key: installer.install_setting.texture.label
      value: "Runiverse OS Texture"
    - key: installer.install_setting.texture.one_line
      value: "非同期ランタイム画像ロード"
    - key: installer.install_setting.texture.description
      value: "FreeImage で画像をデコードし、Burst でミップマップを生成してから Unity のメインスレッドで Texture2D データをアップロードします。メモリ、ストリームと RuniOS IO ノードを入力として受け取ります。"
