.runios-setup__welcome {
    flex-grow: 1;
    justify-content: center;
    align-items: center;
    flex-direction: row;
}

.runios-setup__welcome-logo {
    width: 100px;
    height: 100px;
    margin-left: 20px;
    margin-right: 20px;
    visibility: hidden;
}

.runios-setup__welcome-headings {
    height: 40px;
    margin-bottom: 20px;
}

.runios-setup__welcome-headings > * {
    position: absolute;
    font-size: 30px;
    -unity-font-style: bold;
    height: 100%;
    -unity-text-align: middle-left;
}
