    - key: installer.install_setting.sound.label
      value: Runiverse OS Sound
    - key: installer.install_setting.sound.one_line
      value: "\u5171\u901A\u30AA\u30FC\u30C7\u30A3\u30AA API \u3068\u30B5\u30A6\u30F3\u30C9\u30EA\u30BD\u30FC\u30B9"
    - key: installer.install_setting.sound.description
      value: "\u30AA\u30FC\u30C7\u30A3\u30AA\u5B9F\u88C5\u3067\u5171\u6709\u3059\u308B\u30AF\u30EA\u30C3\u30D7\u3001\u518D\u751F\u30FB\u7A7A\u9593\u30AA\u30FC\u30C7\u30A3\u30AA\u306E\u5951\u7D04\u3001\nUnity \u306E\u30AA\u30FC\u30C7\u30A3\u30AA\u30BD\u30FC\u30B9\u30B3\u30F3\u30DD\u30FC\u30CD\u30F3\u30C8\u3068\u30B5\u30A6\u30F3\u30C9\u30EA\u30BD\u30FC\u30B9\u767B\u9332\u3092\u63D0\u4F9B\u3057\u307E\u3059\u3002"
    - key: installer.install_setting.effects.label
      value: Runiverse OS Effects
    - key: installer.install_setting.effects.one_line
      value: "\u89D2\u4E38\u3068\u30A2\u30A6\u30C8\u30E9\u30A4\u30F3\u30A8\u30D5\u30A7\u30AF\u30C8"
    - key: installer.install_setting.effects.description
      value: "Unity UI \u306E\u89D2\u4E38\u3068\u30E1\u30C3\u30B7\u30E5\u306E\u30A2\u30A6\u30C8\u30E9\u30A4\u30F3\u30A8\u30D5\u30A7\u30AF\u30C8\u3092\u63D0\u4F9B\u3057\u307E\u3059\u3002\n\u8907\u6570\u30AA\u30D6\u30B8\u30A7\u30AF\u30C8\u306E\u30A2\u30A6\u30C8\u30E9\u30A4\u30F3\u3092\u7D50\u5408\u3059\u308B\u30A8\u30D5\u30A7\u30AF\u30C8\u3082\u542B\u307F\u307E\u3059\u3002"
    - key: installer.install_setting.fmod.label
      value: FMOD for RuniOS
    - key: installer.install_setting.fmod.one_line
      value: "RuniOS \u5411\u3051 FMOD \u30AA\u30FC\u30C7\u30A3\u30AA\u518D\u751F"
    - key: installer.install_setting.fmod.description
      value: "RuniOS \u30B5\u30A6\u30F3\u30C9\u30EA\u30BD\u30FC\u30B9\u3068\u9023\u643A\u3059\u308B FMOD Core \u30B5\u30A6\u30F3\u30C9\u30B7\u30B9\u30C6\u30E0\u3001\u30AA\u30FC\u30C7\u30A3\u30AA\u30AF\u30EA\u30C3\u30D7\u3001\n\u518D\u751F\u30C1\u30E3\u30F3\u30CD\u30EB\u3068\u30C1\u30E3\u30F3\u30CD\u30EB\u30B0\u30EB\u30FC\u30D7\u3092\u63D0\u4F9B\u3057\u307E\u3059\u3002\nFMOD for Unity \u306E\u7D71\u5408\u306F\u5225\u9014\u7528\u610F\u3059\u308B\u5FC5\u8981\u304C\u3042\u308A\u3001Setup \u3067\u306F\u30A4\u30F3\u30B9\u30C8\u30FC\u30EB\u3057\u307E\u305B\u3093\u3002"
    - key: installer.install_setting.nbs.label
      value: Runiverse OS NBS
    - key: installer.install_setting.nbs.one_line
      value: "Note Block Studio \u30D5\u30A1\u30A4\u30EB\u306E\u30ED\u30FC\u30C9\u3068\u518D\u751F"
    - key: installer.install_setting.nbs.description
      value: "RuniOS \u30EA\u30BD\u30FC\u30B9\u30D1\u30C3\u30AF\u304B\u3089 Note Block Studio \u30D5\u30A1\u30A4\u30EB\u3092\u8AAD\u307F\u8FBC\u307F\u3001FMOD \u3067\u97F3\u7B26\u3092\u518D\u751F\u3057\u307E\u3059\u3002\n\u30C6\u30F3\u30DD\u30DE\u30C3\u30D7\u3001\u30AB\u30B9\u30BF\u30E0\u697D\u5668\u3068\u30A8\u30C7\u30A3\u30BF\u30FC\u30D7\u30EC\u30D3\u30E5\u30FC\u306B\u5BFE\u5FDC\u3057\u307E\u3059\u3002"
    - key: installer.install_setting.texture.label
      value: Runiverse OS Texture
    - key: installer.install_setting.texture.one_line
      value: "\u975E\u540C\u671F\u30E9\u30F3\u30BF\u30A4\u30E0\u753B\u50CF\u30ED\u30FC\u30C9"
    - key: installer.install_setting.texture.description
      value: "FreeImage \u3067\u753B\u50CF\u3092\u30C7\u30B3\u30FC\u30C9\u3057\u3001Burst \u3067\u30DF\u30C3\u30D7\u30DE\u30C3\u30D7\u3092\u751F\u6210\u3057\u3066\u304B\u3089\nUnity \u306E\u30E1\u30A4\u30F3\u30B9\u30EC\u30C3\u30C9\u3067 Texture2D \u30C7\u30FC\u30BF\u3092\u30A2\u30C3\u30D7\u30ED\u30FC\u30C9\u3057\u307E\u3059\u3002\n\n\u30E1\u30E2\u30EA\u3001\u30B9\u30C8\u30EA\u30FC\u30E0\u3068 RuniOS IO \u30CE\u30FC\u30C9\u3092\u5165\u529B\u3068\u3057\u3066\u53D7\u3051\u53D6\u308A\u307E\u3059\u3002"
