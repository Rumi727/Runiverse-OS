        \"value\"\uC5EC\uC57C \uD569\uB2C8\uB2E4."
    - key: serializable_nullable.invalid_serialization_type
      value: "\uC798\uBABB\uB41C \uC9C1\uB82C\uD654 \uD0C0\uC785\uC785\uB2C8\uB2E4"
    - key: identifier.invalid.namespace
      value: "\uC798\uBABB\uB41C \uB124\uC784\uC2A4\uD398\uC774\uC2A4\uC785\uB2C8\uB2E4:
        '{value}'.\n\uD5C8\uC6A9\uB418\uB294 \uBB38\uC790\uB294 'a-z', '0-9', '.',
        '-', '_'\uC785\uB2C8\uB2E4."
    - key: identifier.invalid.path
      value: "\uC798\uBABB\uB41C \uACBD\uB85C\uC785\uB2C8\uB2E4: '{value}'.\n\uD5C8\uC6A9\uB418\uB294
        \uBB38\uC790\uB294 'a-z', '0-9', '.', '/', '-', '_'\uC785\uB2C8\uB2E4."
    - key: ui.unclamped_slider.tooltip
      value: "\uC2AC\uB77C\uC774\uB354 \uBC94\uC704\uC640 \uAD00\uACC4\uC5C6\uC774
        \uC801\uC6A9\uB418\uB294 \uAC12 \uC81C\uD55C\uC785\uB2C8\uB2E4. null\uC774\uBA74
        \uD574\uB2F9 \uBC29\uD5A5\uC73C\uB85C \uC81C\uD55C\uC774 \uC5C6\uC2B5\uB2C8\uB2E4."
    - key: internal.auto_setter.property.info
      value: "RuniOS\uAC00 \uC62C\uBC14\uB974\uAC8C \uC791\uB3D9\uD560 \uC218 \uC788\uB3C4\uB85D
        {name} \uC18D\uC131 \uAC12\uC744 \uBCC0\uACBD\uD588\uC2B5\uB2C8\uB2E4."
