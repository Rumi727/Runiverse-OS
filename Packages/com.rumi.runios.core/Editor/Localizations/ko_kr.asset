    - key: serializable_dictionary_property_drawer.not_found.key
      value: "\uC9C1\uB82C\uD654 \uAC00\uB2A5\uD55C \uD544\uB4DC \"serializableKeys\"\uAC00
        \uC874\uC7AC\uD558\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4.\nGUI\uC5D0 \uC790\uB3D9\uC73C\uB85C
        \uD45C\uC2DC\uD558\uB824\uBA74 \uD544\uB4DC \uC774\uB984\uC774 \uC815\uD655\uD788
        \"serializableKeys\"\uC5EC\uC57C \uD569\uB2C8\uB2E4."
    - key: serializable_dictionary_property_drawer.not_found.value
      value: "\uC9C1\uB82C\uD654 \uAC00\uB2A5\uD55C \uD544\uB4DC \"serializableValues\"\uAC00
        \uC874\uC7AC\uD558\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4.\nGUI\uC5D0 \uC790\uB3D9\uC73C\uB85C
        \uD45C\uC2DC\uD558\uB824\uBA74 \uD544\uB4DC \uC774\uB984\uC774 \uC815\uD655\uD788
        \"serializableValues\"\uC5EC\uC57C \uD569\uB2C8\uB2E4."
    - key: serializable_key_value_pair_property_drawer.not_found.key
      value: "\uC9C1\uB82C\uD654 \uAC00\uB2A5\uD55C \uD544\uB4DC \"key\"\uAC00 \uC874\uC7AC\uD558\uC9C0
        \uC54A\uC2B5\uB2C8\uB2E4.\nGUI\uC5D0 \uC790\uB3D9\uC73C\uB85C \uD45C\uC2DC\uD558\uB824\uBA74
        \uD544\uB4DC \uC774\uB984\uC774 \uC815\uD655\uD788 \"key\"\uC5EC\uC57C \uD569\uB2C8\uB2E4."
    - key: serializable_key_value_pair_property_drawer.not_found.value
      value: "\uC9C1\uB82C\uD654 \uAC00\uB2A5\uD55C \uD544\uB4DC \"value\"\uAC00
        \uC874\uC7AC\uD558\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4.\nGUI\uC5D0 \uC790\uB3D9\uC73C\uB85C
