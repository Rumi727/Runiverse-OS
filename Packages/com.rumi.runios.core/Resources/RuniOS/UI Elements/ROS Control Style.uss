.unity-foldout {
    flex-shrink: 0;
}

.unity-composite-field .unity-composite-field__field--last {
    margin-right: 0;
}

.runios-foldout__viewport-clipping {
    transition-property: height;
    transition-duration: 0.5s;
    transition-timing-function: ease-out-cubic;
    overflow: hidden;
    flex-grow: 1;
}

.runios-foldout__viewport {
    overflow: scroll;
    flex-shrink: 0;
}

.unity-foldout__content {
    flex-shrink: 0;
    overflow: visible;
}

.runios-hex-color-field .unity-color-field {
    margin-left: 0;
}

.runios-file-path-field .unity-text-field {
    margin-left: 0;
}

.runios-identifier-field .unity-composite-field__field {
    margin-right: 0;
}

.runios-identifier-field #separator {
    margin-left: 2px;
    margin-right: 2px;
    -unity-text-align: upper-center;
}

.runios-identifier-field .unity-composite-field__field--last {
    flex-grow: 2;
}

.runios-progress-bar__viewport {
    transform-origin: left;
}

.runios-type-field {
}

.runios-type-field .unity-base-field__input {
    flex-direction: row;
}

.runios-type-field__text {
    flex-grow: 1;
    flex-shrink: 1;
    overflow: hidden;
    text-overflow: ellipsis;
    align-self: center;
    white-space: nowrap;
}

.runios-type-field__button {
    align-self: center;
}
