<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" authoring-id="1071150122" editor-extension-mode="True" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd">
    <Style src="project://database/Packages/io.github.rumi727.runios/Editor/Setup.uss?fileID=7433441132597879392&amp;guid=16323edc23d133dab87dfc47cc33e0e3&amp;type=3#Setup"/>
    <ui:VisualElement name="Header" usage-hints="DynamicTransform" class="runios-setup__header">
        <ui:VisualElement name="Header-Viewport" class="runios-setup__header-viewport">
            <ui:VisualElement name="Header-Logo" class="runios-setup__header-logo"/>
            <ui:Label name="Title" text="Title" class="runios-setup__title"/>
        </ui:VisualElement>
        <ui:VisualElement name="Separator" class="runios-setup__separator runios-setup__separator--horizontal"/>
    </ui:VisualElement>
    <ui:VisualElement name="Viewport" class="runios-setup__viewport">
        <ui:VisualElement name="Track" usage-hints="DynamicTransform" class="runios-setup__track"/>
    </ui:VisualElement>
    <ui:VisualElement name="Footer" class="runios-setup__footer">
        <ui:VisualElement name="Separator" class="runios-setup__separator runios-setup__separator--horizontal"/>
        <ui:VisualElement name="Footer-Viewport" class="runios-setup__footer-viewport">
            <ui:Button focusable="false" name="Left" text="&lt;" class="runios-setup__navigation runios-setup__navigation-button runios-setup__navigation-button--left"/>
            <ui:Label name="Page" text="1/1" class="runios-setup__navigation runios-setup__navigation-page"/>
            <ui:Button focusable="false" name="Right" text="&gt;" class="runios-setup__navigation runios-setup__navigation-button runios-setup__navigation-button--right"/>
            <ui:VisualElement name="Flexible-Space" class="runios-setup__flexible-space"/>
            <ui:DropdownField choices="English (US)" focusable="false" index="0" name="Dropdown" class="runios-setup__dropdown"/>
        </ui:VisualElement>
    </ui:VisualElement>
    <ui:VisualElement name="Logo" usage-hints="DynamicTransform" class="runios-setup__logo"/>
</ui:UXML>
