%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 4877a65100aa43f7b113ba2717f32cbc, type: 3}
  m_Name: ko_kr
  m_EditorClassIdentifier: 
  texts:
    pairs:
    - key: language.name
      value: "\uD55C\uAD6D\uC5B4"
    - key: language.region
      value: "\uB300\uD55C\uBBFC\uAD6D"
    - key: installer.welcome
      value: "\uD658\uC601\uD569\uB2C8\uB2E4!"
    - key: installer.welcome.text
      value: "Runi Engine\uC744 \uC0AC\uC6A9\uD574 \uC8FC\uC154\uC11C \uAC10\uC0AC\uD569\uB2C8\uB2E4.\n\uC9C0\uAE08\uBD80\uD130 \uC5D4\uC9C4\uC758 \uCD08\uAE30 \uC124\uC815\uC744 \uC2DC\uC791\uD569\uB2C8\uB2E4."
    - key: installer.tmp_setting.label
      value: "TMP \uB9AC\uC18C\uC2A4"
    - key: installer.tmp_setting.warning
      value: "TextMesh Pro \uD328\uD0A4\uC9C0\uAC00 \uAE54\uB824\uC788\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4."
    - key: installer.tmp_setting.info
      value: "ROS \uD328\uD0A4\uC9C0\uB294 Unity\uC758 TextMesh Pro \uD328\uD0A4\uC9C0\uB97C \uC0AC\uC6A9\uD569\uB2C8\uB2E4.\n\uC6D0\uD65C\uD55C \uC0AC\uC6A9\uC744 \uC704\uD574 TextMesh Pro\uC758 \uAE30\uBCF8 \uB9AC\uC18C\uC2A4\uB97C \uC784\uD3EC\uD2B8\uD558\uB294 \uAC83\uC744 \uAD8C\uC7A5\uD569\uB2C8\uB2E4."
    - key: installer.tmp_setting.essentials.title
      value: "TMP \uAE30\uBCF8 \uB9AC\uC18C\uC2A4"
    - key: installer.tmp_setting.essentials.info
      value: "TextMesh Pro \uAE30\uBCF8 \uB9AC\uC18C\uC2A4\uB97C Assets/TextMesh Pro\uC5D0 \uAC00\uC838\uC635\uB2C8\uB2E4."
    - key: installer.tmp_setting.essentials.update
      value: "\uC124\uCE58\uB41C TMP \uB9AC\uC18C\uC2A4 \uC5C5\uB370\uC774\uD2B8 \uD544\uC694. TMP Settings\uB97C \uC720\uC9C0\uD558\uBA70 \uB2E4\uC2DC \uAC00\uC838\uC635\uB2C8\uB2E4."
    - key: installer.tmp_setting.essentials.import
      value: "TMP \uAE30\uBCF8 \uB9AC\uC18C\uC2A4 \uAC00\uC838\uC624\uAE30"
    - key: installer.tmp_setting.examples.title
      value: "TMP \uC608\uC81C \uBC0F \uCD94\uAC00 \uB9AC\uC18C\uC2A4"
    - key: installer.tmp_setting.examples.info
      value: "TextMesh Pro \uC0AC\uC6A9\uC744 \uB3D5\uB294 \uC120\uD0DD\uC801\uC778 \uC608\uC81C\uC640 \uCD94\uAC00 \uB9AC\uC18C\uC2A4. \uAE30\uBCF8 \uB9AC\uC18C\uC2A4\uBD80\uD130 \uAC00\uC838\uC624\uC138\uC694."
    - key: installer.tmp_setting.examples.update
      value: "\uC5C5\uB370\uC774\uD2B8\uB41C TMP \uC608\uC81C\uC640 \uCD94\uAC00 \uB9AC\uC18C\uC2A4\uB97C \uB2E4\uC2DC \uAC00\uC838\uC635\uB2C8\uB2E4."
    - key: installer.tmp_setting.examples.import
      value: "TMP \uC608\uC81C \uBC0F \uCD94\uAC00 \uB9AC\uC18C\uC2A4 \uAC00\uC838\uC624\uAE30"
    - key: installer.setup.roots.title
      value: "\uD328\uD0A4\uC9C0 \uC120\uD0DD"
    - key: installer.setup.preview.title
      value: "\uC124\uCE58 \uC2DC\uAC04!"
    - key: installer.setup.preview.info
      value: "\uC120\uD0DD\uD55C root\uC640 dependency\uB97C Package Management\uAC00 \uD655\uC778\uD569\uB2C8\uB2E4. \uBBF8\uB9AC\uBCF4\uAE30\uB294 \uCC38\uACE0 \uC815\uBCF4\uC774\uBA70 \uC124\uCE58 \uC2DC \uD604\uC7AC \uC0C1\uD0DC\uB97C \uB2E4\uC2DC \uD655\uC778\uD569\uB2C8\uB2E4. \uC120\uD0DD \uD574\uC81C\uB85C \uAE30\uC874 \uD328\uD0A4\uC9C0\uB97C \uC81C\uAC70\uD558\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4. TMP \uB9AC\uC18C\uC2A4\uB294 TMP \uD654\uBA74\uC5D0\uC11C \uBCC4\uB3C4\uB85C \uAC00\uC838\uC635\uB2C8\uB2E4."
    - key: installer.setup.preview.empty
      value: "\uC120\uD0DD\uD55C root \uD328\uD0A4\uC9C0 \uC5C6\uC74C."
    - key: installer.setup.preview.observing
      value: "\uC124\uCE58 \uC694\uAD6C\uC0AC\uD56D \uD655\uC778 \uC911\u2026"
    - key: installer.setup.preview.ensuring
      value: "\uC124\uCE58 \uC694\uAD6C\uC0AC\uD56D \uC801\uC6A9 \uC911\u2026"
    - key: installer.setup.preview.ready
      value: "\uBBF8\uB9AC\uBCF4\uAE30 \uC644\uB8CC. \uC124\uCE58 \uC2DC \uD604\uC7AC \uC0C1\uD0DC\uB97C \uB2E4\uC2DC \uD655\uC778\uD569\uB2C8\uB2E4."
    - key: installer.setup.preview.version_change_title
      value: "\uD328\uD0A4\uC9C0 \uBC84\uC804 \uAD50\uCCB4 \uC2B9\uC778"
    - key: installer.setup.preview.version_change_message
      value: "\uC694\uCCAD\uD55C \uBC84\uC804\uACFC \uD604\uC7AC \uC124\uCE58\uB41C \uBC84\uC804\uC774 \uB2E4\uB978 \uD328\uD0A4\uC9C0\uAC00 \uC788\uC2B5\uB2C8\uB2E4.\n\uC694\uCCAD\uD55C \uBC84\uC804\uC73C\uB85C \uAD50\uCCB4\uD560\uAE4C\uC694?"
    - key: installer.setup.preview.version_change_accept
      value: "\uAD50\uCCB4"
    - key: installer.setup.preview.version_change_decline
      value: "\uD604\uC7AC \uBC84\uC804 \uC720\uC9C0"
    - key: installer.setup.preview.embedded_conflict_title
      value: "Embedded \uD328\uD0A4\uC9C0 \uCDA9\uB3CC"
    - key: installer.setup.preview.embedded_conflict_message
      value: "\uC694\uCCAD\uD55C \uD328\uD0A4\uC9C0\uAC00 \uC774\uBBF8 Embedded \uC0C1\uD0DC\uC785\uB2C8\uB2E4.\n\uB85C\uCEEC \uC218\uC815\uC0AC\uD56D\uC774 \uC788\uC744 \uC218 \uC788\uC5B4 \uC774 \uD328\uD0A4\uC9C0\uB294 \uBCC0\uACBD\uB418\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4.\n\n\uB098\uBA38\uC9C0 \uC124\uCE58\uB97C \uACC4\uC18D\uD560\uAE4C\uC694?"
    - key: installer.setup.preview.embedded_conflict_confirm
      value: "\uD655\uC778"
    - key: installer.setup.preview.embedded_conflict_cancel
      value: "\uCDE8\uC18C"
    - key: installer.setup.preview.embedded_conflict_warning
      value: "Embedded \uCDA9\uB3CC: \uB85C\uCEEC \uC218\uC815 \uBCF4\uD638\uB97C \uC704\uD574 \uC774 \uD328\uD0A4\uC9C0\uB294 \uBCC0\uACBD\uB418\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4."
    - key: installer.setup.preview.graph_error
      value: "\uC124\uCE58 \uC804 dependency graph \uC624\uB958 \uD574\uACB0 \uD544\uC694."
    - key: installer.setup.preview.complete
      value: "\uBAA8\uB4E0 \uC124\uCE58 \uC694\uAD6C\uC0AC\uD56D \uCDA9\uC871."
    - key: installer.setup.preview.assembly_required
      value: "\uD328\uD0A4\uC9C0 \uC124\uBA85\uC5D0 \uBA85\uC2DC\uB41C \uC678\uBD80 \uD1B5\uD569\uC744 \uBA3C\uC800 \uC784\uD3EC\uD2B8\uD55C \uB4A4 \uC0C8\uB85C \uACE0\uCE68\uD558\uC138\uC694."
    - key: installer.setup.preview.failed
      value: "\uC2E4\uD328. \uC9C4\uB2E8 \uB0B4\uC6A9 \uD655\uC778 \uD544\uC694."
    - key: installer.setup.preview.cancelled
      value: "\uCDE8\uC18C\uB428. \uC774\uBBF8 \uC2DC\uC791\uD55C UPM \uC694\uCCAD\uC740 \uC644\uB8CC\uAE4C\uC9C0 \uAE30\uB2E4\uB838\uC2B5\uB2C8\uB2E4."
    - key: installer.setup.preview.refresh
      value: "\uBBF8\uB9AC\uBCF4\uAE30 \uC0C8\uB85C \uACE0\uCE68"
    - key: installer.setup.preview.cancel
      value: "\uCDE8\uC18C"
    - key: installer.setup.preview.root
      value: "\uC120\uD0DD\uD55C root"
    - key: installer.setup.preview.dependency
      value: Dependency
    - key: installer.setup.preview.satisfied
      value: "\uC774\uBBF8 \uCDA9\uC871\uB428"
    - key: installer.setup.preview.required
      value: "\uC124\uCE58 \uD544\uC694"
    - key: installer.setup.preview.version_change_required
      value: "\uBC84\uC804 \uAD50\uCCB4 \uC2B9\uC778 \uD544\uC694"
    - key: installer.setup.preview.registry_required
      value: "Registry \uC900\uBE44 \uD544\uC694. \uD328\uD0A4\uC9C0 \uD68D\uB4DD\uC740 UPM\uC5D0 \uC704\uC784"
    - key: installer.setup.preview.delegated
      value: "Registry \uC900\uBE44\uB428. \uD328\uD0A4\uC9C0 \uD68D\uB4DD\uC740 \uC704\uC784\uB418\uBA70 \uAC80\uC99D\uD558\uC9C0 \uC54A\uC74C"
    - key: installer.setup.preview.unsupported
      value: "\uC774 executor\uB294 \uBBF8\uB9AC\uBCF4\uAE30\uB97C \uC9C0\uC6D0\uD558\uC9C0 \uC54A\uC74C"
    - key: installer.install_setting.install
      value: "\uC124\uCE58"
    - key: installer.install_setting.dependency
      value: "\uC885\uC18D\uC131"
    - key: installer.install_setting.core.label
      value: Runiverse OS Core
    - key: installer.install_setting.core.one_line
      value: "\uACF5\uD1B5 \uC720\uD2F8\uB9AC\uD2F0\uC640 \uB9AC\uC18C\uC2A4 \uAD00\uB9AC"
    - key: installer.install_setting.core.description
      value: "RuniOS \uD328\uD0A4\uC9C0\uAC00 \uACF5\uC720\uD558\uB294 \uC720\uD2F8\uB9AC\uD2F0, \uBE44\uB3D9\uAE30 \uC791\uC5C5, IO \uCD94\uC0C1\uD654, \uB9AC\uC18C\uC2A4 \uD329\uACFC \uC9C0\uC5ED\uD654 \uAE30\uB2A5\uC744 \uC81C\uACF5\uD569\uB2C8\uB2E4."
    - key: installer.install_setting.core_editor.label
      value: "Runiverse OS Core Editor"
    - key: installer.install_setting.core_editor.one_line
      value: "RuniOS \uACF5\uD1B5 \uC5D0\uB514\uD130 \uB3C4\uAD6C"
    - key: installer.install_setting.core_editor.description
      value: "\uC778\uC2A4\uD399\uD130, IMGUI\u00B7UI Toolkit \uD544\uB4DC, \uC5D0\uB514\uD130 \uC9C0\uC5ED\uD654\uC640 \uB9AC\uC18C\uC2A4 \uD0D0\uC0C9 \uB4F1 RuniOS \uACF5\uD1B5 \uC5D0\uB514\uD130 \uB3C4\uAD6C\uB97C \uC81C\uACF5\uD569\uB2C8\uB2E4."
    - key: installer.install_setting.uielements.label
      value: "Runiverse OS UI Elements"
    - key: installer.install_setting.uielements.one_line
      value: "Unity UI Toolkit\uc6a9 \ud544\ub4dc\uc640 \uc870\uc791\uae30"
    - key: installer.install_setting.uielements.description
      value: "RuniOS\uc758 UI Toolkit \ucee8\ud2b8\ub864, \ub9ac\uc18c\uc2a4 \uc5f0\ub3d9\uacfc \uc9c0\uc5ed\ud654 \uae30\ub2a5\uc744 \uc81c\uacf5\ud569\ub2c8\ub2e4."
    - key: installer.install_setting.windows.label
      value: Runiverse OS Windows
    - key: installer.install_setting.windows.one_line
      value: "Windows \uD50C\uB7AB\uD3FC \uC9C0\uC6D0"
    - key: installer.install_setting.windows.description
      value: "RuniOS IO API\uB97C \uD1B5\uD574 Windows\uC758 \uC54C\uB824\uC9C4 \uD3F4\uB354\uC640 \uBCFC\uB968 \uB9C8\uC6B4\uD2B8 \uC704\uCE58\uB97C \uC81C\uACF5\uD569\uB2C8\uB2E4."
    - key: installer.install_setting.linux.label
      value: Runiverse OS Linux
    - key: installer.install_setting.linux.one_line
      value: "Linux \uD50C\uB7AB\uD3FC \uC9C0\uC6D0"
    - key: installer.install_setting.linux.description
      value: "RuniOS IO API\uB97C \uD1B5\uD574 Linux\uC758 \uC0AC\uC6A9\uC790 \uB514\uB809\uD130\uB9AC, \uB9C8\uC6B4\uD2B8 \uC704\uCE58\uC640 UDisks2 \uC800\uC7A5 \uC7A5\uCE58 \uC704\uCE58\uB97C \uC81C\uACF5\uD569\uB2C8\uB2E4."
    - key: installer.install_setting.ui.label
      value: Runiverse OS UI
    - key: installer.install_setting.ui.one_line
      value: "RuniOS\uC758 \uACF5\uC2DD \uB7F0\uD0C0\uC784 UI/UX \uC2DC\uC2A4\uD15C"
    - key: installer.install_setting.ui.description
      value: "osu!lazer\uC5D0\uC11C \uC601\uAC10\uC744 \uBC1B\uC740 \uB514\uC790\uC778\uC73C\uB85C RuniOS\uC758 \uC5EC\uB7EC \uAE30\uB2A5\uC744 \uC81C\uC5B4\uD560 \uB7F0\uD0C0\uC784 UI/UX \uC2DC\uC2A4\uD15C\uC785\uB2C8\uB2E4.\nUI/UX \uAD6C\uD604\uC740 \uC608\uC815\uB418\uC5B4 \uC788\uC73C\uBA70 \uD604\uC7AC \uCEF4\uD3EC\uB10C\uD2B8\uB294 \uB9AC\uC18C\uC2A4\uB97C Unity UI\uC5D0 \uC5F0\uACB0\uD569\uB2C8\uB2E4."
    - key: installer.install_setting.sound.label
      value: Runiverse OS Sound
    - key: installer.install_setting.sound.one_line
      value: "\uACF5\uD1B5 \uC624\uB514\uC624 API\uC640 \uC0AC\uC6B4\uB4DC \uB9AC\uC18C\uC2A4"
    - key: installer.install_setting.sound.description
      value: "\uC624\uB514\uC624 \uAD6C\uD604\uC774 \uACF5\uC720\uD558\uB294 \uD074\uB9BD, \uC7AC\uC0DD\xB7\uACF5\uAC04 \uC74C\uD5A5 \uACC4\uC57D,\nUnity \uC624\uB514\uC624 \uC18C\uC2A4 \uCEF4\uD3EC\uB10C\uD2B8\uC640 \uC0AC\uC6B4\uB4DC \uB9AC\uC18C\uC2A4 \uB4F1\uB85D \uAE30\uB2A5\uC744 \uC81C\uACF5\uD569\uB2C8\uB2E4."
    - key: installer.install_setting.effects.label
      value: Runiverse OS Effects
    - key: installer.install_setting.effects.one_line
      value: "\uB465\uADFC \uBAA8\uC11C\uB9AC\uC640 \uC678\uACFD\uC120 \uD6A8\uACFC"
    - key: installer.install_setting.effects.description
      value: "Unity UI\uC758 \uB465\uADFC \uBAA8\uC11C\uB9AC\uC640 \uBA54\uC2DC \uC678\uACFD\uC120 \uD6A8\uACFC\uB97C \uC81C\uACF5\uD569\uB2C8\uB2E4.\n\uC5EC\uB7EC \uC624\uBE0C\uC81D\uD2B8\uC758 \uC678\uACFD\uC120\uC744 \uD569\uCE58\uB294 \uD6A8\uACFC\uB3C4 \uD3EC\uD568\uD569\uB2C8\uB2E4."
    - key: installer.install_setting.fmod.label
      value: FMOD for RuniOS
    - key: installer.install_setting.fmod.one_line
      value: "RuniOS\uC6A9 FMOD \uC624\uB514\uC624 \uC7AC\uC0DD"
    - key: installer.install_setting.fmod.description
      value: "RuniOS \uC0AC\uC6B4\uB4DC \uB9AC\uC18C\uC2A4\uC640 \uC5F0\uACB0\uB41C FMOD Core \uC0AC\uC6B4\uB4DC \uC2DC\uC2A4\uD15C,\uC624\uB514\uC624 \uD074\uB9BD, \uC7AC\uC0DD \uCC44\uB110\uACFC \uCC44\uB110 \uADF8\uB8F9\uC744 \uC81C\uACF5\uD569\uB2C8\uB2E4.\nFMOD for Unity \uD1B5\uD569\uC740 \uBCC4\uB3C4\uB85C \uC900\uBE44\uD574\uC57C \uD558\uBA70 Setup\uC5D0\uC11C \uC124\uCE58\uD558\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4."
    - key: installer.install_setting.nbs.label
      value: Runiverse OS NBS
    - key: installer.install_setting.nbs.one_line
      value: "Note Block Studio \uD30C\uC77C \uB85C\uB4DC\uC640 \uC7AC\uC0DD"
    - key: installer.install_setting.nbs.description
      value: "RuniOS \uB9AC\uC18C\uC2A4 \uD329\uC5D0\uC11C Note Block Studio \uD30C\uC77C\uC744 \uC77D\uACE0 FMOD\uB85C \uC74C\uD45C\uB97C \uC7AC\uC0DD\uD569\uB2C8\uB2E4.\n\uD15C\uD3EC \uB9F5, \uCEE4\uC2A4\uD140 \uC545\uAE30\uC640 \uC5D0\uB514\uD130 \uBBF8\uB9AC\uBCF4\uAE30\uB97C \uC9C0\uC6D0\uD569\uB2C8\uB2E4."
    - key: installer.install_setting.texture.label
      value: Runiverse OS Texture
    - key: installer.install_setting.texture.one_line
      value: "\uBE44\uB3D9\uAE30 \uB7F0\uD0C0\uC784 \uC774\uBBF8\uC9C0 \uB85C\uB4DC"
    - key: installer.install_setting.texture.description
      value: "FreeImage\uB85C \uC774\uBBF8\uC9C0\uB97C \uB514\uCF54\uB4DC\uD558\uACE0 Burst\uB85C \uBC09\uB9F5\uC744 \uC0DD\uC131\uD55C \uB4A4\nUnity \uBA54\uC778 \uC2A4\uB808\uB4DC\uC5D0\uC11C Texture2D \uB370\uC774\uD130\uB97C \uC5C5\uB85C\uB4DC\uD569\uB2C8\uB2E4.\n\n\uBA54\uBAA8\uB9AC, \uC2A4\uD2B8\uB9BC\uACFC RuniOS IO \uB178\uB4DC\uB97C \uC785\uB825\uC73C\uB85C \uBC1B\uC2B5\uB2C8\uB2E4."
